# Примусове обмеження під 8MB Flash (розмір образу для прошивки)
CONFIG_FIRMWARE_COMPTEST_8M=y

# Оптимізація під 64 МБ оперативної пам'яті (RAM)
CONFIG_FIRMWARE_CHOSEN_MAX_MEM_64M=y

# Вимикаємо важкі компоненти, щоб прошивка влізла в ліміт пам'яті
CONFIG_FIRMWARE_INCLUDE_OPENVPN=n
CONFIG_FIRMWARE_INCLUDE_SSWAN=n
CONFIG_FIRMWARE_INCLUDE_SHADOWSOCKS=n
CONFIG_FIRMWARE_INCLUDE_TRANSMISSION=n
CONFIG_FIRMWARE_INCLUDE_ARIA=n
CONFIG_FIRMWARE_INCLUDE_CURL=n
CONFIG_FIRMWARE_INCLUDE_SCRPT=n
CONFIG_FIRMWARE_INCLUDE_HTTPS=n

# Очищення від непотрібних медіа-утиліт
CONFIG_FIRMWARE_INCLUDE_DUMP1090=n
CONFIG_FIRMWARE_INCLUDE_XUPNPD=n
CONFIG_FIRMWARE_INCLUDE_MINIDLNA=n
CONFIG_FIRMWARE_INCLUDE_FIREFLY=n
